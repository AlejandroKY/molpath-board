# ─── MolPath Board · variables de entorno ────────────────────────────────
# Copiar a .env y ajustar. NUNCA subir .env al repositorio.

# PostgreSQL
POSTGRES_DB=molpath
POSTGRES_USER=molpath
POSTGRES_PASSWORD=change-me-local-only

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/molpath
SPRING_DATASOURCE_USERNAME=molpath
SPRING_DATASOURCE_PASSWORD=change-me-local-only
# Secreto HS256 de al menos 32 bytes. Generar p. ej. con: openssl rand -base64 48
MOLPATH_JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
MOLPATH_JWT_TTL_MINUTES=480
# Login de desarrollo (selector de usuarios demo). Desactivar en producción.
MOLPATH_DEV_LOGIN_ENABLED=true
# Siembra el dataset ficticio si la base de datos está vacía.
MOLPATH_DEMO_SEED=true
# Orígenes permitidos por CORS, separados por comas.
MOLPATH_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Proveedores externos
# Opcional: aumenta el límite de NCBI de 3 a 10 req/s. https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
# Email de contacto que NCBI recomienda enviar en E-utilities (parámetro "email").
NCBI_CONTACT_EMAIL=
# OncoKB permanece desactivado hasta revisión de licencia (ADR-012).
MOLPATH_ONCOKB_ENABLED=false

# Frontend (build)
# api  -> usa el backend REST     | demo -> datos en el navegador (GitHub Pages)
VITE_DATA_MODE=api
VITE_API_BASE_URL=http://localhost:8080
